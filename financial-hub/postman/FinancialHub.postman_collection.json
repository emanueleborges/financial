{
  "info": {
    "name": "Financial Hub API",
    "description": "Coleção de endpoints — CPF/CNPJ como chave pública",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "document1", "value": "52998224725" },
    { "key": "document2", "value": "39053344705" },
    { "key": "transactionId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (CPF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"{{document1}}\",\n  \"password\": \"senha123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Criar Usuário Alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('document1', pm.response.json().document);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Silva\",\n  \"email\": \"alice@email.com\",\n  \"document\": \"52998224725\",\n  \"password\": \"senha123\",\n  \"initialBalance\": 2000.00\n}"
            },
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "Criar Usuário Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('document2', pm.response.json().document);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Santos\",\n  \"email\": \"bob@email.com\",\n  \"document\": \"39053344705\",\n  \"password\": \"senha123\",\n  \"initialBalance\": 500.00\n}"
            },
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "Buscar Usuário por CPF",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/users/{{document1}}"
          }
        },
        {
          "name": "Consultar Saldo por CPF",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/users/{{document1}}/balance"
          }
        },
        {
          "name": "Listar Extrato por CPF",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/users/{{document1}}/transactions?limit=50"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Transferir (CPF → CPF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('transactionId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "transfer-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerDocument\": \"{{document1}}\",\n  \"payeeDocument\": \"{{document2}}\",\n  \"amount\": 150.00\n}"
            },
            "url": "{{baseUrl}}/api/v1/transactions"
          }
        },
        {
          "name": "Consultar Transação",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/transactions/{{transactionId}}"
          }
        },
        {
          "name": "Exportar Comprovante PDF",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/receipt"
          }
        },
        {
          "name": "Estornar Transação",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"reason\": \"Estorno solicitado pelo usuário\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/transactions/reverse"
          }
        }
      ]
    }
  ]
}
